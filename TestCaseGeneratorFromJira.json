    {
      "parameters": {
        "jsCode": "// Format AI-generated test cases into a markdown table for Google Docs\nconst items = $input.all();\n\n// Start building the markdown table\nlet markdownTable = '# Test Cases\\n\\n';\nmarkdownTable += '| Test Case ID | Name | Description | Preconditions | Steps | Expected Results | Priority |\\n';\nmarkdownTable += '|--------------|------|-------------|---------------|-------|------------------|----------|\\n';\n\n// Iterate through each test case\nfor (const item of items) {\n  const testCase = item.json.output;\n  \n  // Format the steps array into a numbered list\n  let stepsFormatted = '';\n  if (testCase.steps && Array.isArray(testCase.steps)) {\n    stepsFormatted = testCase.steps\n      .map(step => `${step.stepNumber}. ${step.action}`)\n      .join('<br>');\n  }\n  \n  // Add row to table\n  markdownTable += `| ${testCase.testCaseId || ''} | ${testCase.testCaseName || ''} | ${testCase.description || ''} | ${testCase.preconditions || ''} | ${stepsFormatted} | ${testCase.expectedResults || ''} | ${testCase.priority || ''} |\\n`;\n}\n\n// Return the formatted table\nreturn [{\n  json: {\n    formattedTable: markdownTable\n  }\n}];"
      },
      "id": "647a446f-4e99-4a6c-b32b-4c9ae70f9ec8",
